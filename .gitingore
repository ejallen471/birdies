# .gitignore template - delete things that are not relevant


# Generated output files or large data files produced by running the code
output/
outputs/
results/
data/raw/
data/processed/
*.log
logs/
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.zip
*.tar.gz
tmp/
temp/


# Compiled binaries
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.a
*.lib
*.class
*.pyc
*.pyo
*.wasm


# Packages/environments (node_modules/, .venv/, __pycache__/)
node_modules/
.venv/
venv/
env/
.env/
__pycache__/
*.egg-info/
.eggs/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
.conda/
renv/
.Rproj.user/
.Rhistory
.RData


# IDE/OS files (.idea/, .DS_Store, .vscode/)
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
desktop.ini


# Build artefacts (dist/, build/)
dist/
build/
out/
target/
.next/
.cache/
*.whl


# Sensitive or confidential information (e.g. passwords, keys, personal data)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets/
credentials.json
*secret*
*.sqlite
*.db
